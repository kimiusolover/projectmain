diff --git a/BaseTools/Conf/tools_def.template b/BaseTools/Conf/tools_def.template
index 72ca0df..5ae1d18 100644
--- a/BaseTools/Conf/tools_def.template
+++ b/BaseTools/Conf/tools_def.template
@@ -1591,3 +1591,21 @@ RELEASE_XCODE5_X64_CC_FLAGS   = -target x86_64-pc-win32-macho -c    -Os       -W
 # Build rule order
 #################
 *_*_*_*_BUILDRULEORDER = nasm asm Asm ASM S s nasmb asm16
+
+
+################################################################################
+# MIPS o32 bring-up: compilation and static library only
+################################################################################
+
+DEFINE GCC_MIPS_ABI_FLAGS = -EL -march=mips32r2 -mabi=32 -msoft-float -mno-abicalls -fno-pic -fno-pie -G0 -mno-mips16 -mno-micromips
+
+*_GCC_MIPS_CC_PATH    = ENV(GCC_MIPS_PREFIX)gcc
+*_GCC_MIPS_ASM_PATH   = ENV(GCC_MIPS_PREFIX)gcc
+*_GCC_MIPS_PP_PATH    = ENV(GCC_MIPS_PREFIX)gcc
+*_GCC_MIPS_SLINK_PATH = ENV(GCC_MIPS_PREFIX)ar
+
+*_GCC_MIPS_CC_FLAGS = DEF(GCC_MIPS_ABI_FLAGS) -g -O0 -ffreestanding -fshort-wchar -fno-short-enums -fno-builtin -fno-strict-aliasing -fno-common -fno-stack-protector -fno-asynchronous-unwind-tables -fno-unwind-tables -Wall -Werror -include AutoGen.h
+
+*_GCC_MIPS_ASM_FLAGS = DEF(GCC_MIPS_ABI_FLAGS) -x assembler-with-cpp -g
+*_GCC_MIPS_PP_FLAGS  = DEF(GCC_MIPS_ABI_FLAGS) -E -x assembler-with-cpp
+*_GCC_MIPS_SLINK_FLAGS =
